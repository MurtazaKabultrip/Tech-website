# Copy to .env and fill in. Never commit .env.
SITE_NAME=Novaforge
SITE_BASE_URL=http://localhost:8080
CONTACT_EMAIL=hello@example.com
NOTIFICATION_EMAIL=hello@example.com

POSTGRES_PASSWORD=change-me-to-a-long-random-string

# First admin account, created on startup if it doesn't exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Change-Me-Now-2026

# Optional: card payments (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: AI project briefs (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: outgoing e-mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
