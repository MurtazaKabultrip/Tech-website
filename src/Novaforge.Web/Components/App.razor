<!DOCTYPE html>
@inject SiteSettingsService SiteSettings
<html lang="en" data-theme="@SiteSettings.Current.Theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="@(SiteSettings.Current.IsDark ? "dark" : "light")" />
    <base href="/" />
    <script src="@Assets["js/site.js"]"></script>
    <link rel="preload" href="@Assets["fonts/InterDisplay-Light.woff"]" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="@Assets["fonts/Inter-Regular.woff"]" as="font" type="font/woff" crossorigin />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>
<body>
    <Routes @rendermode="PageRenderMode" />
    <div id="blazor-error-ui" role="alert">
        Something went wrong.
        <a href="" class="reload">Reload</a>
        <span class="dismiss" aria-label="Dismiss">✕</span>
    </div>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Portal and admin pages run interactively over a Blazor Server circuit. Public pages and account
    // forms opt out with [ExcludeFromInteractiveRouting] (see Pages/_Imports.razor) so they are static
    // server-rendered: fast, SEO-friendly, and they work without JavaScript.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
