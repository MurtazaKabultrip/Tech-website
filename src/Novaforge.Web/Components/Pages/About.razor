@page "/about"
@inject IOptions<SiteOptions> Site

<Seo Title="About us" Description="@($"{Site.Value.Name} is a digital studio that designs, builds and looks after websites, online shops, booking systems, web apps and mobile apps.")" />

@* ============ INTRO (night) ============ *@
<section class="page-head about-hero">
    <div class="container about-hero-grid">
        <div>
            <p class="x-pill"><span class="x-pulse" aria-hidden="true"></span> 10+ years building for the web</p>
            <h1>We build the web <span class="x-grad">we'd want to use.</span></h1>
            <p class="lede">
                For more than ten years we have designed, engineered and looked after websites, online shops,
                booking systems, web apps and mobile apps — and rescued the ones that stopped working.
                @Site.Value.Name brings that experience to businesses that want more than a template.
            </p>
            <div class="x-actions" style="margin-top:32px">
                <a class="btn btn--glow btn--lg" href="/contact">Work with us</a>
                <a class="btn btn--glass btn--lg" href="/process">How we work</a>
            </div>
        </div>

        <div class="x-term glass" aria-hidden="true">
            <div class="x-term-bar"><span class="mock-dots"><i></i><i></i><i></i></span><span>every-release.log</span></div>
            <ol class="x-term-lines">
                <li><b>›</b> design&nbsp;&nbsp;approved by client <em>✓</em></li>
                <li><b>›</b> build&nbsp;&nbsp;&nbsp;.NET 10 · Release <em>✓</em></li>
                <li><b>›</b> test&nbsp;&nbsp;&nbsp;&nbsp;unit + integration + browser <em>✓</em></li>
                <li><b>›</b> check&nbsp;&nbsp;&nbsp;security headers · CSP <em>✓</em></li>
                <li><b>›</b> speed&nbsp;&nbsp;&nbsp;PageSpeed target 95+ <em>✓</em></li>
                <li><b>›</b> deploy&nbsp;&nbsp;zero downtime <em>✓</em></li>
                <li class="x-term-ok">Live. Guarantee active for 12 months.<span class="x-caret"></span></li>
            </ol>
        </div>
    </div>
</section>

@* ============ STORY (day) ============ *@
<section class="section tone-alt" aria-labelledby="story-h">
    <div class="container about-story">
        <div class="x-head" style="margin:0">
            <h2 id="story-h">Why <span class="x-grad">we exist</span></h2>
        </div>
        <div class="about-story-text">
            <p>Too many businesses pay for a website that looks fine on launch day and then slowly breaks: plugins stop updating, pages get slower, a payment form fails and nobody knows why.</p>
            <p>After more than a decade of building and fixing software, we've seen what makes projects fail — and what makes them last. We started @Site.Value.Name to do it differently. Every project is engineered like a product — designed for real customers, tested automatically before every release, secured from day one, and looked after long after it goes live.</p>
            <p>Whether it's a five-page company site, a B2B and B2C flight booking platform or a mobile app, the standard is the same: fast, beautiful, reliable — and yours.</p>
        </div>
    </div>
</section>

@* ============ EXPERIENCE (night) ============ *@
<section class="section" aria-labelledby="exp-h">
    <div class="container about-exp">
        <div class="about-exp-num" data-reveal>
            <b><span data-count="10">10</span>+</b>
            <span>years of experience</span>
        </div>
        <div>
            <div class="x-head" style="margin-bottom:28px">
                <h2 id="exp-h">A decade of building. <span class="x-grad">You get all of it.</span></h2>
                <p>Ten years of real projects means we've already solved the problems your project will meet.</p>
            </div>
            <ul class="about-exp-list">
                @foreach (var (title, text) in Experience)
                {
                    <li data-reveal>
                        <span class="tile-icon"><Icon Name="check" /></span>
                        <div><h3>@title</h3><p>@text</p></div>
                    </li>
                }
            </ul>
        </div>
    </div>
</section>

@* ============ VALUES (night) ============ *@
<section class="section tone-alt" aria-labelledby="values-h">
    <div class="container">
        <div class="x-head">
            <h2 id="values-h">What we <span class="x-grad">stand for</span></h2>
            <p>Six promises that shape every line of code and every pixel we deliver.</p>
        </div>
        <div class="bento bento--even">
            @foreach (var v in Values)
            {
                <article class="tile spot" data-reveal>
                    <span class="tile-icon"><Icon Name="@v.Icon" /></span>
                    <h3>@v.Title</h3>
                    <p>@v.Text</p>
                </article>
            }
        </div>
    </div>
</section>

@* ============ COMMITMENTS (day) ============ *@
<section class="section" aria-labelledby="commit-h">
    <div class="container">
        <div class="x-head">
            <h2 id="commit-h">Commitments, <span class="x-grad">not slogans</span></h2>
            <p>What every client gets, on every project, in writing.</p>
        </div>
        <div class="x-stats">
            <div class="x-stat glass spot" data-reveal><b>1 year</b><span>Free bug fixes and support guarantee</span></div>
            <div class="x-stat glass spot" data-reveal><b><span data-count="100">100</span>%</b><span>Code, design and accounts you own</span></div>
            <div class="x-stat glass spot" data-reveal><b><span data-count="95">95</span>+</b><span>Google PageSpeed target</span></div>
            <div class="x-stat glass spot" data-reveal><b><span data-count="10">10</span>+</b><span>Years of experience</span></div>
        </div>
    </div>
</section>

@* ============ WHO WE WORK WITH (night) ============ *@
<section class="section tone-alt" aria-labelledby="who-h">
    <div class="container about-who">
        <div class="x-head" style="margin:0">
            <h2 id="who-h">Who we <span class="x-grad">work with</span></h2>
            <p>From first-time founders to established companies — if you need it online, we build it.</p>
        </div>
        <ul class="about-who-list">
            @foreach (var (title, text) in Clients)
            {
                <li class="glass spot" data-reveal>
                    <h3>@title</h3>
                    <p>@text</p>
                </li>
            }
        </ul>
    </div>
</section>

@* ============ TECHNOLOGY (day) ============ *@
<section class="section" aria-labelledby="tech-h">
    <div class="container">
        <div class="x-head">
            <h2 id="tech-h">Modern technology, <span class="x-grad">chosen on purpose</span></h2>
            <p>.NET 10 and TypeScript are our foundation. We pick every other tool because it's the best fit for your project — never because it's trendy.</p>
        </div>
        <ul class="stack-chips">
            @foreach (var t in Tech)
            {
                <li class="chip">@t</li>
            }
        </ul>
    </div>
</section>

@* ============ CTA (night) ============ *@
<section class="section tone-alt" aria-labelledby="about-cta-h">
    <div class="container">
        <div class="x-cta spot">
            <h2 id="about-cta-h">Let's build something <span class="x-grad">people remember.</span></h2>
            <p>Tell us about your idea or the website that needs help. You'll get a clear plan and price within 24 hours.</p>
            <div class="x-actions" style="justify-content:center">
                <a class="btn btn--glow btn--lg" href="/contact">Start your project</a>
                <a class="btn btn--glass btn--lg" href="/services">See our services</a>
            </div>
        </div>
    </div>
</section>

@code {
    private sealed record Value(string Icon, string Title, string Text);

    private static readonly Value[] Values =
    [
        new("sparkles", "Design that converts", "Beautiful is the start. Every layout is built to turn visitors into calls, bookings and sales."),
        new("gauge", "Fast by default", "Lightweight pages, optimised images and clean code, measured against Google's own speed tests."),
        new("shield", "Secure from day one", "Hosted payments, strict security headers, protected logins and regular updates — never an afterthought."),
        new("check", "Tested before it's done", "Automated tests run on every change. We fix, retest and only then call a task finished."),
        new("file", "Honest, clear pricing", "A written plan and price per phase before we start. You always know what you pay for."),
        new("wrench", "We stay after launch", "A 1-year service guarantee, then care plans for hosting, updates and new features."),
    ];

    private static readonly (string Title, string Text)[] Clients =
    [
        ("Startups & founders", "Turn an idea into a product: landing page, MVP, web app or mobile app — built to grow."),
        ("Local businesses", "Restaurants, clinics, salons and shops that want more bookings and more customers online."),
        ("Online stores", "Shops that need a checkout that converts, smooth payments and an admin that's easy to use."),
        ("Travel & booking", "B2B and B2C platforms with live search, availability, agents and secure payments."),
        ("Growing companies", "Portals, dashboards and integrations that connect your systems and save your team hours."),
        ("Teams with an old website", "Slow, broken or outdated sites rescued, secured and modernised without starting over."),
    ];

    private static readonly (string Title, string Text)[] Experience =
    [
        ("Fewer surprises", "We know where projects usually go wrong, so we plan for it before it costs you time or money."),
        ("Faster delivery", "Proven patterns for shops, bookings, payments and logins mean we don't reinvent what already works."),
        ("Every kind of project", "Company sites, online shops, B2B and B2C booking platforms, web apps and mobile apps."),
        ("Old and new technology", "We modernise legacy systems as confidently as we build on .NET 10 — so nothing is too old to fix."),
        ("Advice you can trust", "Honest recommendations on what you need now, what can wait, and what you don't need at all."),
    ];

    private static readonly string[] Tech =
    [
        ".NET 10", "C#", "TypeScript", "Blazor", "ASP.NET Core", ".NET MAUI", "PostgreSQL", "SQL Server", "Redis",
        "Python", "JavaScript", "REST & GraphQL", "Stripe", "PayPal", "Claude AI", "Docker", "GitHub Actions", "Azure", "AWS"
    ];
}
