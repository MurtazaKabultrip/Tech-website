@page "/services"

<Seo Title="Services" Description="Websites, online shops, web apps, mobile apps, design, payments, AI, integrations, hosting, security and website rescue." />

<section class="page-head">
    <div class="container">
        <h1>Everything you need, <span class="x-grad">one studio</span></h1>
        <p class="lede">Twelve services that work together. Use one, or let us take your whole project from idea to launch and beyond.</p>
    </div>
</section>

<section class="section section--tight">
    <div class="container">
        <div class="bento bento--even">
            @foreach (var service in ServiceCatalog.All)
            {
                <a class="tile spot" href="/services/@service.Slug" data-reveal>
                    <span class="tile-icon"><Icon Name="@service.Icon" /></span>
                    <h3>@service.Title</h3>
                    <p>@service.Summary</p>
                    <span class="x-link tile-more">Learn more <Icon Name="arrow-right" /></span>
                </a>
            }
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="x-head">
            <h2>Built with <span class="x-grad">modern technology</span></h2>
            <p>.NET 10 and TypeScript are our foundation for websites, APIs and mobile apps. When a project needs something else, we use it.</p>
        </div>
        <ul class="stack-chips">
            @foreach (var tech in Tech)
            {
                <li class="chip">@tech</li>
            }
        </ul>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="x-cta spot">
            <h2>Not sure what you need? <span class="x-grad">Ask us.</span></h2>
            <p>Describe your idea or problem in a few lines. We'll recommend the right approach and a fixed price.</p>
            <div class="x-actions" style="justify-content:center"><a class="btn btn--glow btn--lg" href="/contact">Get a free quote</a></div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] Tech =
    [
        ".NET 10", "C#", "ASP.NET Core", "Blazor", ".NET MAUI", "Entity Framework Core", "PostgreSQL", "SQL Server",
        "Redis", "TypeScript", "JavaScript", "Python", "Java", "Kotlin", "Swift", "PHP", "REST", "GraphQL",
        "Stripe", "PayPal", "Adyen", "Claude API", "Docker", "GitHub Actions", "Azure", "AWS"
    ];
}
